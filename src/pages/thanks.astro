---
import Base from '../layouts/Base.astro';
---

<Base title="Message sent" noindex>
  <section class="dots band">
    <div class="wrap">
      <span class="sticker cyan" style="--r:-3deg">
        message sent
      </span>
      <h1 class="display-lg mt-8 max-w-3xl">
        Thanks. It's in my <span class="hl cyan now">inbox.</span>
      </h1>
      <p class="lede mt-6">
        I read every message myself and reply from my own address, usually within a couple of working days
        (Perth time).
      </p>
      <a href="/" class="btn btn-ink mt-9">
        Back to the site{' '}
        <span class="arrow" aria-hidden="true">
          →
        </span>
      </a>
    </div>
  </section>
</Base>
