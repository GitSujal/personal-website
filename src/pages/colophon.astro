---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/ui/PageHeader.astro';

const rows = [
  {
    label: 'Design',
    value:
      'The Data Sparta "workbench" language, shared with datasparta.com: warm paper, 2px ink outlines, hard offset shadows, tape, stamps and marker highlights.',
  },
  {
    label: 'Type',
    value:
      'Bricolage Grotesque (headings), Figtree (body) and Caveat (the handwriting), self-hosted via Fontsource.',
  },
  {
    label: 'Colour',
    value: 'Brand cyan #3EC1D3 on warm paper and teal-ink, with a text-safe deep cyan for small type.',
  },
  {
    label: 'Stack',
    value:
      'Astro with the @astrojs/cloudflare adapter on Cloudflare Workers, the same stack as datasparta.com. Pages are prerendered; only /api/contact runs on the Worker.',
  },
  {
    label: 'Contact form',
    value:
      'Cloudflare Turnstile, then Cloudflare Email Service via the send_email binding. Messages are emailed, never stored.',
  },
  { label: 'Privacy', value: 'No analytics, no trackers, no cookies.' },
  { label: 'Build', value: `${__BUILD_COMMIT__} · ${__BUILD_DATE__}` },
];
---

<Base title="Colophon" description="How sujal.datasparta.com is made: design, type, stack and privacy.">
  <PageHeader
    eyebrow="colophon"
    title="Where this site ++came++ from."
    description="A data engineer's site should be able to say where everything came from. This is the lineage of this one."
  />
  <section class="band band-paper2 zig-t">
    <dl class="wrap grid max-w-4xl gap-4">
      {rows.map((row, i) => (
        <div class="paper flat grid gap-1 p-5 sm:grid-cols-[10rem_1fr]" data-reveal style={`--d:${i}`}>
          <dt class="hand text-2xl text-[color:var(--cyan-deep)]">{row.label}</dt>
          <dd>{row.value}</dd>
        </div>
      ))}
    </dl>
  </section>
</Base>
