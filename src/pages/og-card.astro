---
/**
 * Source for public/og.png (the social share image). Not linked or indexed.
 * Regenerate: npm run build && npx wrangler dev, then
 *   chrome --headless --hide-scrollbars --window-size=1200,630 --screenshot=public/og.png http://127.0.0.1:8787/og-card/
 */
import { Font } from 'astro:assets';
import '../styles/global.css';
---

<!doctype html>
<html lang="en-AU" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>OG card</title>
    <Font cssVariable="--font-raleway" preload />
    <Font cssVariable="--font-merriweather" />
  </head>
  <body class="m-0">
    <div class="flex h-[630px] w-[1200px] overflow-hidden bg-white">
      <div class="flex w-[64px] shrink-0 justify-center bg-black pt-24">
        <span class="font-display text-[15px] tracking-[0.42em] text-white [writing-mode:vertical-rl]">sujal.datasparta.com</span>
      </div>
      <div class="flex flex-1 flex-col justify-between p-[72px] pb-16">
        <p class="label m-0 text-navy!">Sujal Dhungana · Data engineer · Perth</p>
        <h1 class="m-0 max-w-[16em] font-display text-[92px] leading-[0.98] font-black tracking-[-0.03em] text-black">
          Data platforms that stand the <span class="marker">test of time.</span>
        </h1>
        <div class="flex items-end justify-between border-t-2 border-black pt-5 font-display">
          <p class="m-0 text-[22px] font-semibold text-[#4b5560]">$600K+/yr saved · 1 TB/hr · Days → minutes MLOps</p>
          <span class="size-12 bg-teal"></span>
        </div>
      </div>
    </div>
  </body>
</html>
