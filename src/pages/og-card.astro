---
/**
 * Source for public/og.png (the social share image). Not linked or indexed.
 * Regenerate: npm run build && npx wrangler dev, then
 *   chrome --headless --hide-scrollbars --force-prefers-reduced-motion --window-size=1200,800 --screenshot=og.png http://127.0.0.1:8787/og-card/
 *   then crop to 1200x630 (headless viewports are shorter than the window) and save as public/og.png.
 */
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/figtree';
import '@fontsource/caveat/700.css';
import '../styles/global.css';
import Badge from '../components/ui/Badge.astro';
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>OG card</title>
  </head>
  <body class="m-0">
    <div class="dots relative flex h-[630px] w-[1200px] flex-col justify-between overflow-hidden p-[72px]">
      <span class="sticker marker self-start text-base" style="--r:-3deg">
        Sujal Dhungana · Data · Platform · Forward deployed
      </span>
      <h1 class="max-w-[13em] text-[96px] leading-[0.92] tracking-[-0.04em]">
        <span class="hl cyan now">AI-ready</span> data platforms, built to last.
      </h1>
      <p class="hand text-[40px]">1 TB/hr streaming · $600K+/yr saved · secure data for AI agents</p>
      <div class="absolute top-14 right-16">
        <Badge class="h-60 w-60 text-[color:var(--ink)]" />
      </div>
    </div>
  </body>
</html>
