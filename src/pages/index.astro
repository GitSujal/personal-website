---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import ContactForm from '../components/ContactForm.astro';
import Todo from '../components/Todo.astro';
import Icon from '../components/ui/Icon.astro';
import portrait from '../assets/portrait.png';
import { involvement, receipts, site } from '../data/site';
import { aiReady, hats, home } from '../data/copy';
import { rich } from '../lib/rich';
import { byDateDesc, byOrder, byStartDesc, formatSpan, formatYearMonth } from '../lib/format';

const roles = (await getCollection('roles')).sort(byStartDesc);
const now = roles.filter((r) => r.data.current);
const career = await Promise.all(
  roles
    .filter((r) => ['work', 'contract', 'venture'].includes(r.data.kind))
    .map(async (role) => ({ role, ...(await render(role)) })),
);
const learning = roles.filter((r) => ['education', 'volunteer'].includes(r.data.kind));
const work = await Promise.all(
  (await getCollection('work')).sort(byOrder).map(async (entry) => ({ entry, ...(await render(entry)) })),
);
const talks = (await getCollection('talks', ({ data }) => data.verified || import.meta.env.DEV)).sort(
  byDateDesc,
);
const writing = (await getCollection('writing')).sort(byDateDesc);

const tilts = ['-1.2deg', '0.9deg', '-0.5deg', '1.3deg', '-0.9deg', '0.6deg'];
const fills = ['', 'bg-primary text-[#111]', '', '', 'bg-[color:var(--marker)] text-[#14181a]', ''];

const marquee = home.marquee;
const kindLabel = {
  work: 'Full-time',
  contract: 'Contract',
  venture: 'Founder',
  education: 'Study',
  volunteer: 'Volunteer',
};
---

<Base>
  <Hero />

  <!-- marquee -->
  <div class="band-cyan relative -rotate-1 border-y-2 border-[#111] py-4" aria-hidden="true">
    <div class="marquee font-display text-2xl font-extrabold sm:text-3xl">
      <div class="marquee-inner">
        {[0, 1, 2, 3].map(() => (
          <div class="marquee-track">
            {marquee.map((t) => (
              <>
                <span class="whitespace-nowrap">{t}</span>
                <svg viewBox="0 0 24 24" class="h-6 w-6 shrink-0">
                  <path d="M12 1l2.6 8.4L23 12l-8.4 2.6L12 23l-2.6-8.4L1 12l8.4-2.6z" fill="#111" />
                </svg>
              </>
            ))}
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- receipts -->
  <section class="band" aria-labelledby="receipts-title">
    <div class="wrap">
      <p class="eyebrow" data-reveal>
        {home.receipts.eyebrow}
      </p>
      <h2 id="receipts-title" class="display-lg mt-2 max-w-3xl" data-reveal style="--d:1">
        <Fragment set:html={rich(home.receipts.title)} />
      </h2>
      <p class="lede mt-6" data-reveal style="--d:2">
        {home.receipts.lede}
      </p>
      <ul class="mt-14 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {receipts.map((s, i) => (
          <li
            class:list={['paper lift p-6', fills[i]]}
            data-reveal
            style={`--d:${i % 3}; rotate:${tilts[i]}`}
          >
            {i === 0 && <span class="tape" aria-hidden="true" />}
            <p class="font-display text-[clamp(2.4rem,4vw,3.4rem)] leading-none font-extrabold tracking-tight">
              {s.value}
            </p>
            <p class="mt-3 text-lg font-semibold">{s.label}</p>
            <p class="hand mt-4 text-xl opacity-80">↳ {s.source}</p>
          </li>
        ))}
      </ul>
      <a
        href="/lab/"
        class="paper mt-14 flex flex-wrap items-center justify-between gap-4 p-5 sm:p-6"
        style="--hover-r:0.4deg"
        data-reveal
      >
        <span>
          <span class="sticker cyan" style="--r:-3deg">
            new
          </span>
          <span class="ml-3 font-display text-xl font-extrabold">{home.lab.title}</span>
          <span class="mt-1 block muted">{home.lab.body}</span>
        </span>
        <span class="btn btn-ink">
          Open the lab{' '}
          <span class="arrow" aria-hidden="true">
            →
          </span>
        </span>
      </a>
    </div>
  </section>

  <!-- three hats -->
  <section id="roles" class="band band-paper2 zig-t" aria-labelledby="hats-title">
    <div class="wrap">
      <p class="eyebrow" data-reveal>
        {home.hats.eyebrow}
      </p>
      <h2 id="hats-title" class="display-lg mt-2 max-w-4xl" data-reveal style="--d:1">
        <Fragment set:html={rich(home.hats.title)} />
      </h2>
      <p class="lede mt-6" data-reveal style="--d:2">
        {home.hats.lede}
      </p>
      <div class="mt-14 grid gap-8 lg:grid-cols-3">
        {hats.map((h, i) => (
          <article
            class:list={['paper lift flex flex-col p-7', i === 2 && 'bg-primary text-[#111]']}
            data-reveal
            style={`--d:${i}; rotate:${tilts[i]}`}
          >
            {i === 0 && <span class="tape" aria-hidden="true" />}
            <span class="hand text-2xl opacity-80">hat no. {i + 1}</span>
            <h3 class="mt-1 text-3xl">{h.title}</h3>
            <p class:list={['mt-3', i === 2 ? 'text-[#1c2a2e]' : 'muted']}>{h.body}</p>
            <ul class="tick-list mt-auto pt-4">
              {h.evidence.map((e) => (
                <li class:list={[i === 2 && '!text-[#1c2a2e]']}>{e}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- now -->
  <section id="now" class="band" aria-labelledby="now-title">
    <div class="wrap">
      <p class="eyebrow" data-reveal>
        {home.now.eyebrow}
      </p>
      <h2 id="now-title" class="display-lg mt-2" data-reveal style="--d:1">
        <Fragment set:html={rich(home.now.title)} />
      </h2>
      <div class="mt-14 grid gap-8 lg:grid-cols-2">
        {now.map(({ data }, i) => (
          <article
            class="paper lift flex flex-col p-6"
            data-reveal
            style={`--d:${i}; rotate:${tilts[i + 1]}`}
          >
            <span
              class:list={['sticker', i === 0 ? 'cyan' : 'marker', 'self-start']}
              style={`--r:${i % 2 ? 3 : -3}deg`}
            >
              {data.kind === 'venture' ? 'my own' : 'day job'} · since {formatYearMonth(data.start)}
            </span>
            <h3 class="mt-5 text-2xl">{data.title}</h3>
            <p class="font-display text-lg font-bold text-[color:var(--cyan-deep)]">{data.org}</p>
            {data.summary && <p class="mt-3 muted">{data.summary}</p>}
            {data.todo && (
              <p class="mt-3">
                <Todo text={data.todo} />
              </p>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- selected work -->
  <section id="work" class="band" aria-labelledby="work-title">
    <div class="wrap">
      <p class="eyebrow" data-reveal>
        {home.work.eyebrow}
      </p>
      <h2 id="work-title" class="display-lg mt-2 max-w-3xl" data-reveal style="--d:1">
        <Fragment set:html={rich(home.work.title)} />
      </h2>
      <div class="mt-16 grid gap-16">
        {work.map(({ entry, Content }, i) => (
          <article class="grid items-start gap-8 lg:grid-cols-[auto_1fr_20rem]" data-reveal>
            <p class="num text-[clamp(4rem,8vw,6.5rem)]" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </p>
            <div>
              <h3 class="display-md">{entry.data.title}</h3>
              <div class="prose-body mt-5 text-lg">
                <Content />
              </div>
            </div>
            <aside
              class="receipt"
              aria-label={`Source for ${entry.data.title}`}
              style={`rotate:${i % 2 ? '1.2deg' : '-1.2deg'}`}
            >
              <span class="sticker marker absolute -top-4 right-4 text-xs" style="--r:4deg">
                receipt
              </span>
              <p>
                <strong>{entry.data.result}</strong>
              </p>
              <p>ctx: {entry.data.context}</p>
              <p>stack: {entry.data.stack}</p>
              {entry.data.also && <p>also: {entry.data.also}</p>}
            </aside>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- how I work -->
  <section id="ai-ready" class="band-ink zig-t band relative overflow-hidden" aria-labelledby="how-title">
    <div class="wrap">
      <p class="eyebrow !text-[color:var(--cyan)]" data-reveal>
        {home.aiReady.eyebrow}
      </p>
      <h2 id="how-title" class="display-lg mt-2 max-w-4xl" data-reveal style="--d:1">
        <Fragment set:html={rich(home.aiReady.title)} />
      </h2>
      <p class="lede mt-6 !text-[color:var(--ink-soft)]" data-reveal style="--d:2">
        {home.aiReady.lede}
      </p>
      <div class="relative mt-16 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
        <svg
          class="route pointer-events-none absolute top-10 left-0 hidden h-10 w-full lg:block"
          viewBox="0 0 1000 40"
          preserveAspectRatio="none"
          aria-hidden="true"
        >
          <path
            d="M90 20 C 200 -10, 300 50, 380 20 S 560 -10, 640 20 S 820 50, 910 20"
            fill="none"
            stroke="#3ec1d3"
            stroke-width="4"
            stroke-linecap="round"
            vector-effect="non-scaling-stroke"
          ></path>
        </svg>
        {aiReady.map((p, i) => (
          <div class="relative" data-reveal style={`--d:${i + 1}`}>
            <div
              class="grid h-20 w-20 place-items-center rounded-full border-2 border-[#111] bg-primary font-display text-4xl font-extrabold text-[#111] shadow-[4px_4px_0_#000]"
              style={`rotate:${i % 2 ? 6 : -6}deg`}
            >
              {i + 1}
            </div>
            <h3 class="mt-6 text-2xl">{p.title}</h3>
            <p class="mt-3 max-w-sm opacity-85">{p.body}</p>
            <p class="hand mt-4 text-xl text-[color:var(--cyan)]">↳ {p.where}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- experience -->
  <section id="experience" class="band" aria-labelledby="exp-title">
    <div class="wrap grid gap-14 lg:grid-cols-[1fr_20rem]">
      <div>
        <p class="eyebrow" data-reveal>
          {home.experience.eyebrow}
        </p>
        <h2 id="exp-title" class="display-lg mt-2" data-reveal style="--d:1">
          <Fragment set:html={rich(home.experience.title)} />
        </h2>
        <ol class="timeline mt-12">
          {career.map(({ role: { data }, Content }) => (
            <li class:list={[data.current && !data.end && 'is-current']} data-reveal>
              <details class="group paper flat mb-5 p-0" style="box-shadow:4px 4px 0 var(--shadow)">
                <summary class="flex cursor-pointer flex-wrap items-center gap-x-4 gap-y-1 p-5">
                  <span class="min-w-0 flex-1">
                    <span class="block font-display text-xl font-extrabold">{data.title}</span>
                    <span class="block font-semibold text-[color:var(--cyan-deep)]">{data.org}</span>
                  </span>
                  <span class="text-sm font-semibold muted tabular-nums">
                    {formatSpan(data.start, data.end)}
                  </span>
                  <span class="sticker text-[0.7rem]" style="--r:2deg">
                    {kindLabel[data.kind]}
                  </span>
                  <span class="chev grid h-8 w-8 place-items-center rounded-full border-2 border-[color:var(--line)]">
                    <Icon name="chev" class="h-4 w-4" />
                  </span>
                </summary>
                <div class="prose-body border-t-2 border-dashed border-[color:var(--divider)] px-5 pt-4 pb-6">
                  <Content />
                  {data.tags.length > 0 && <p class="hand text-xl">{data.tags.join(' · ')}</p>}
                </div>
              </details>
            </li>
          ))}
        </ol>
      </div>
      <aside class="lg:pt-28">
        <div class="paper p-6" style="rotate:1.2deg" data-reveal="pop">
          <span class="tape cyan" aria-hidden="true"></span>
          <p class="font-display text-2xl font-extrabold">{home.experience.pdfTitle}</p>
          <p class="mt-2 muted">{home.experience.pdfBody}</p>
          <a href={site.resume} class="btn mt-5 w-full" download>
            Résumé PDF <Icon name="download" />
          </a>
        </div>
        <h3 class="hand mt-12 text-3xl text-[color:var(--cyan-deep)]">{home.experience.sideTitle}</h3>
        <ul class="mt-4 grid gap-4">
          {learning.map(({ data }) => (
            <li class="border-l-4 border-[color:var(--cyan)] pl-4">
              <p class="font-display font-extrabold">{data.title}</p>
              <p class="text-sm muted">
                {data.org} · {formatSpan(data.start, data.end)}
              </p>
            </li>
          ))}
        </ul>
      </aside>
    </div>
  </section>

  <!-- about -->
  <section id="about" class="band band-paper2 zig-t" aria-labelledby="about-title">
    <div class="wrap grid items-center gap-14 lg:grid-cols-[0.9fr_1.1fr]">
      <figure class="paper relative mx-auto w-full max-w-md p-3 pb-14" style="rotate:-3deg" data-reveal="pop">
        <span class="tape" aria-hidden="true"></span>
        <Image
          class="aspect-[4/5] w-full rounded-[4px] border-2 border-[color:var(--line)] object-cover"
          src={portrait}
          width={800}
          height={1000}
          widths={[400, 600, 800]}
          sizes="(min-width: 1024px) 28rem, 90vw"
          alt="Sujal Dhungana, smiling, in a white shirt against a cyan background"
        />
        <figcaption class="hand absolute inset-x-0 bottom-3 text-center text-3xl">
          {home.about.photoCaption}
        </figcaption>
        <span class="stamp absolute -top-6 -right-6 text-sm" aria-hidden="true">
          {home.about.stamp}
        </span>
      </figure>
      <div>
        <p class="eyebrow" data-reveal>
          {home.about.eyebrow}
        </p>
        <h2 id="about-title" class="display-lg mt-2" data-reveal style="--d:1">
          <Fragment set:html={rich(home.about.title)} />
        </h2>
        <div class="prose-body mt-7 text-lg" data-reveal style="--d:2">
          {home.about.paragraphs.map((para) => (
            <p set:html={rich(para)} />
          ))}
        </div>
        <ul class="mt-8 flex flex-wrap gap-3" data-reveal style="--d:3">
          <li class="sticker" style="--r:-2deg">
            B.E. 2017 · Tribhuvan
          </li>
          <li class="sticker cyan" style="--r:2deg">
            M. Predictive Analytics 2020 · Curtin
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- teaching -->
  <section id="teaching" class="band-cyan zig-t band relative overflow-hidden" aria-labelledby="teach-title">
    <div class="wrap grid items-center gap-10 lg:grid-cols-[1.3fr_1fr]">
      <div>
        <p class="eyebrow" data-reveal>
          {home.teaching.eyebrow}
        </p>
        <h2 id="teach-title" class="display-lg mt-2" data-reveal style="--d:1">
          <Fragment set:html={rich(home.teaching.title)} />
        </h2>
      </div>
      <div data-reveal style="--d:2">
        <p class="text-xl text-[#1c2a2e]">{home.teaching.body}</p>
        <div class="mt-7 flex flex-wrap gap-4">
          <a href="/ventures/" class="btn btn-ink">
            About the Academy{' '}
            <span class="arrow" aria-hidden="true">
              →
            </span>
          </a>
          <a href={site.academy} rel="noopener" class="btn btn-paper">
            dataprofessionacademy.com
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- talks & writing -->
  <section id="writing" class="band" aria-labelledby="tw-title">
    <div class="wrap">
      <p class="eyebrow" data-reveal>
        {home.talks.eyebrow}
      </p>
      <h2 id="tw-title" class="display-lg mt-2" data-reveal style="--d:1">
        <Fragment set:html={rich(home.talks.title)} />
      </h2>
      <div class="mt-14 grid gap-12 lg:grid-cols-2">
        <div data-reveal>
          <h3 class="hand text-3xl text-[color:var(--cyan-deep)]">On stage</h3>
          <ul class="mt-4 grid gap-4">
            {talks.map(({ data }, i) => (
              <li class="paper p-5" style={`rotate:${i % 2 ? 0.6 : -0.6}deg`}>
                <p class="text-sm font-semibold muted">
                  {data.date && `${formatYearMonth(data.date)} · `}
                  {data.event}, {data.location}{' '}
                  {!data.verified && <Todo text="[verify — hidden in production]" />}
                </p>
                <p class="mt-1.5 font-display text-xl leading-snug font-extrabold">{data.title}</p>
                {data.format === 'conference' && (
                  <span class="stamp mt-3 text-xs" aria-hidden="true">
                    top paper
                  </span>
                )}
              </li>
            ))}
          </ul>
          <p class="mt-6 muted">
            <strong class="font-display text-[color:var(--ink)]">{involvement.title}</strong> ·{' '}
            {involvement.org}
          </p>
        </div>
        <div data-reveal style="--d:1">
          <h3 class="hand text-3xl text-[color:var(--cyan-deep)]">On the page</h3>
          <ul class="mt-4 grid gap-3">
            {writing.map(({ data }) => (
              <li>
                <a
                  href={data.url}
                  rel="noopener"
                  class="group block border-b-2 border-dashed border-[color:var(--divider)] py-3"
                >
                  <span class="block text-sm font-semibold muted">
                    {formatYearMonth(data.date)} · {data.minutes} min read
                  </span>
                  <span class="mt-1 block font-display text-xl leading-snug font-extrabold group-hover:text-[color:var(--cyan-deep)]">
                    {data.title} <span aria-hidden="true">↗</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- contact -->
  <section id="contact" class="band band-paper2 zig-t" aria-labelledby="contact-title">
    <div class="wrap grid gap-14 lg:grid-cols-[0.85fr_1.15fr]">
      <div>
        <p class="eyebrow" data-reveal>
          {home.contact.eyebrow}
        </p>
        <h2 id="contact-title" class="display-lg mt-2" data-reveal style="--d:1">
          <Fragment set:html={rich(home.contact.title)} />
        </h2>
        <p class="lede mt-7" data-reveal style="--d:2">
          {home.contact.lede}
        </p>
        <ul class="mt-8 grid gap-4" data-reveal style="--d:3">
          <li class="flex items-center gap-4">
            <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full border-2 border-[#111] bg-primary text-[#111]">
              <Icon name="mail" />
            </span>
            <a href={`mailto:${site.email}`} class="ulink text-lg">
              {site.email}
            </a>
          </li>
          <li class="flex items-center gap-4">
            <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full border-2 border-[#111] bg-primary text-[#111]">
              <Icon name="pin" />
            </span>
            <span class="text-lg font-semibold">Perth, WA · {site.timezone}</span>
          </li>
        </ul>
      </div>
      <div class="paper p-6 sm:p-8" style="rotate:0.5deg" data-reveal="pop">
        <span class="tape" aria-hidden="true"></span>
        <ContactForm />
      </div>
    </div>
  </section>
</Base>
