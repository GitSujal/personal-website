---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import ContactForm from '../components/ContactForm.astro';
import Todo from '../components/Todo.astro';
import { site, stats } from '../data/site';
import { byDateDesc, byOrder, byStartDesc, formatSpan, formatYearMonth, isPlaceholder } from '../lib/format';

const roles = (await getCollection('roles')).sort(byStartDesc);
const now = roles.filter((role) => role.data.current);
const experience = await Promise.all(roles.map(async (role) => ({ role, ...(await render(role)) })));
const work = await Promise.all(
  (await getCollection('work')).sort(byOrder).map(async (entry) => ({ entry, ...(await render(entry)) })),
);
const talks = (await getCollection('talks', ({ data }) => data.verified || import.meta.env.DEV)).sort(byDateDesc);
const writing = (await getCollection('writing')).sort(byDateDesc);
---

<Base page="01">
  <!-- Hero -->
  <section aria-labelledby="hero-title" class="wrap flex flex-wrap items-stretch gap-x-14 gap-y-12 pt-[clamp(48px,7vw,96px)] pb-14">
    <div class="flex min-w-0 flex-[999_1_560px] flex-col justify-end">
      <p class="label m-0 mb-6 text-accent!">00 — Thesis</p>
      <h1 id="hero-title" class="m-0 font-display text-[clamp(46px,7vw,100px)] leading-[0.98] font-black tracking-[-0.03em] text-balance">
        Data platforms that stand the <span class="marker">test of time.</span>
      </h1>
      <p class="mt-8 mb-0 max-w-[34em] text-[clamp(17px,1.4vw,19px)] leading-[1.75] text-ink-soft">
        I'm Sujal, a data engineer in Perth. I work in the gap between developer velocity and enterprise-grade
        reliability, and I'm stubborn about one idea: <em class="font-normal">everything as code.</em>
      </p>
      <div class="mt-8 flex flex-wrap gap-x-4 gap-y-3">
        <a href="#work" class="btn btn-ink">Read the work</a>
        <a href="/hire-me/" class="btn btn-line">Work with me</a>
      </div>
    </div>
    <figure class="m-0 flex max-w-[400px] flex-[1_1_300px] flex-col gap-3.5 self-end rounded-[28px] bg-teal p-5">
      <!-- TODO(portrait): replace with <Image src={portrait} …/> once src/assets/portrait.jpg exists. -->
      <div
        role="img"
        aria-label="Portrait coming soon"
        class="flex aspect-[4/5] items-center justify-center rounded-2xl bg-[#ddf3f6] text-center font-display text-xs leading-loose font-semibold tracking-[0.12em] text-navy uppercase"
      >
        [ Portrait ]<br />natural light, 4:5
      </div>
      <figcaption class="font-display text-[13px] font-semibold text-black"><Todo text="[caption: where / when]" /></figcaption>
    </figure>
  </section>

  <!-- Proof ledger -->
  <section aria-label="Selected outcomes" class="wrap">
    <dl class="m-0 grid grid-cols-[repeat(auto-fit,minmax(220px,1fr))] border-y border-t-2 border-rule border-t-ink">
      {
        stats.map((stat) => (
          <div class="py-7 pr-6">
            <dt class="font-display text-[52px] leading-none font-black tracking-[-0.03em] [font-variant-numeric:lining-nums]">{stat.value}</dt>
            <dd class="m-0 mt-2.5 text-[15px] leading-normal">{stat.label}</dd>
            <dd class="m-0 mt-3 font-display text-xs font-semibold text-muted">
              <span class="text-accent">↳</span> src: {stat.source}
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- 01 Now -->
  <section id="now" aria-labelledby="now-title" class="wrap reveal pt-28">
    <SectionHead num="01" title="Now" id="now-title">
      <span class="label ml-auto">Updated Oct 2026</span>
    </SectionHead>
    <div class="grid grid-cols-[repeat(auto-fit,minmax(280px,1fr))] gap-x-10">
      {
        now.map(({ data }) => (
          <article class="border-t-2 border-ink pt-5 pb-8">
            <p class="m-0 font-display text-[12.5px] font-semibold text-muted">
              {formatSpan(data.start, data.end)} {data.todo && <Todo text={data.todo} />}
            </p>
            <h3 class="mt-2.5 mb-1 font-display text-[26px] font-extrabold tracking-[-0.01em]">{data.title}</h3>
            <p class="m-0 text-[17px] italic">{data.org}</p>
            {data.summary && (
              <p class="mt-3.5 mb-0 text-base leading-[1.75] text-ink-soft">
                {isPlaceholder(data.summary) ? <Todo text={data.summary} /> : data.summary}
              </p>
            )}
          </article>
        ))
      }
    </div>
  </section>

  <!-- 02 Selected work -->
  <section id="work" aria-labelledby="work-title" class="wrap pt-28">
    <SectionHead num="02" title="Selected work" id="work-title" />
    {
      work.map(({ entry, Content }, index) => (
        <article class="reveal flex flex-wrap gap-x-12 gap-y-5 border-t border-rule py-10">
          <p class="m-0 flex flex-[0_0_72px] items-start gap-2 pt-2 font-display text-[13px] font-bold text-muted">
            <span aria-hidden="true" class="mt-1 size-2 bg-teal" />
            No. {index + 1}
          </p>
          <div class="min-w-0 flex-[999_1_480px]">
            <h3 class="m-0 font-display text-[clamp(26px,2.6vw,34px)] leading-[1.15] font-extrabold tracking-[-0.015em] text-balance">
              {entry.data.title}
            </h3>
            <div class="prose-body mt-4 max-w-[38em]">
              <Content />
            </div>
          </div>
          <aside aria-label={`Source for ${entry.data.title}`} class="lineage flex-[1_1_260px] self-start">
            <p class="m-0 font-extrabold text-ink">{entry.data.result}</p>
            <p class="m-0">ctx: {entry.data.context}</p>
            <p class="m-0">stack: {entry.data.stack}</p>
            {entry.data.also && <p class="m-0">also: {entry.data.also}</p>}
          </aside>
        </article>
      ))
    }
  </section>

  <!-- 03 Experience -->
  <section id="experience" aria-labelledby="exp-title" class="wrap pt-28">
    <SectionHead num="03" title="Experience" id="exp-title">
      <a href={site.resume} class="ml-auto py-3 font-display text-sm font-bold">Résumé (PDF) ↓</a>
    </SectionHead>
    <ul class="m-0 list-none p-0">
      {
        experience.map(({ role: { data }, Content }) => (
          <li class="border-t border-rule">
            <details class="group">
              <summary class="flex cursor-pointer list-none flex-wrap items-baseline gap-x-8 gap-y-1 py-[18px] [&::-webkit-details-marker]:hidden">
                <span class="flex-[0_0_200px] font-display text-[13.5px] font-semibold text-muted [font-variant-numeric:lining-nums]">
                  {formatSpan(data.start, data.end)}
                </span>
                <span class="min-w-0 flex-[999_1_360px] font-display text-xl font-bold">
                  {data.title} <span class="font-body font-light text-muted italic">— {data.org}</span>
                </span>
                <span class="flex flex-[1_1_140px] items-center justify-end gap-3 font-display text-[11.5px] font-semibold tracking-[0.14em] text-muted uppercase">
                  {data.kind}
                  <span aria-hidden="true" class="inline-block text-lg leading-none text-accent transition-transform group-open:rotate-45">+</span>
                </span>
              </summary>
              <div class="prose-body max-w-[46em] pb-6 md:ml-[232px]">
                <Content />
                {data.tags.length > 0 && (
                  <p class="font-display text-[12.5px] font-semibold text-muted">{data.tags.join(' · ')}</p>
                )}
              </div>
            </details>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- 04 Teaching -->
  <section id="teaching" aria-labelledby="teach-title" class="wrap reveal mt-28">
    <div class="flex flex-wrap gap-x-16 gap-y-8 rounded-[28px] bg-teal p-[clamp(28px,5vw,64px)] text-black">
      <div class="min-w-0 flex-[999_1_520px]">
        <SectionHead num="04" title="Teaching" id="teach-title" tone="on-teal" />
        <blockquote class="m-0 font-display text-[clamp(28px,3vw,42px)] leading-[1.15] font-extrabold tracking-[-0.015em] text-balance">
          We don't just teach tools. We build complete data professionals.
        </blockquote>
      </div>
      <div class="flex-[1_1_320px] text-[16.5px] leading-[1.8] font-normal">
        <p class="m-0">
          Data Profession Academy runs a 12-week curriculum: Python, SQL and Power BI, plus the parts most courses
          skip, like problem solving and data storytelling. Most graduates land their first industry role within three
          months.
        </p>
        <p class="mt-4 mb-0">Before the Academy, I ran a five-week Python masterclass for 20+ members of Nepalese Engineers in WA.</p>
        <a href="/ventures/" class="btn mt-5 bg-black text-white hover:text-white">About the Academy <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- 05 Talks & writing -->
  <section id="writing" aria-labelledby="tw-title" class="wrap reveal pt-28">
    <SectionHead num="05" title="Talks & writing" id="tw-title" />
    <div class="flex flex-wrap gap-x-[72px] gap-y-12">
      <div class="min-w-0 flex-[1_1_460px]">
        <h3 class="label m-0 mb-2">On stage</h3>
        <ul class="m-0 list-none p-0">
          {
            talks.map(({ data }) => (
              <li class="border-t border-rule py-[18px]">
                <p class="m-0 font-display text-[12.5px] font-semibold text-muted">
                  {formatYearMonth(data.date)} · {data.event}, {data.location}{' '}
                  {!data.verified && <Todo text="[verify — hidden in production]" />}
                </p>
                <p class="mt-1.5 mb-0 font-display text-[19px] leading-snug font-bold">{data.title}</p>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="min-w-0 flex-[1_1_460px]">
        <h3 class="label m-0 mb-2">On the page</h3>
        <ul class="m-0 list-none p-0">
          {
            writing.map(({ data }) => (
              <li class="border-t border-rule">
                <a href={data.url} class="block py-[18px] text-ink no-underline hover:underline" rel="noopener">
                  <span class="block font-display text-[12.5px] font-semibold text-muted">
                    {formatYearMonth(data.date)} · {data.minutes} min read
                  </span>
                  <span class="mt-1.5 block font-display text-[19px] leading-snug font-bold">
                    {data.title} <span aria-hidden="true" class="text-accent">↗</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- 06 Story -->
  <section id="story" aria-labelledby="story-title" class="wrap reveal pt-28">
    <SectionHead num="06" title="How I got here" id="story-title" />
    <div class="flex flex-wrap gap-x-[72px] gap-y-10">
      <div class="max-w-[360px] flex-[1_1_280px]">
        <div
          role="img"
          aria-label="Photo coming soon"
          class="flex aspect-[3/4] items-center justify-center rounded-[20px] bg-mist font-display text-xs font-semibold tracking-[0.12em] text-accent uppercase"
        >
          [ Second photo, optional ]
        </div>
        <ul class="mt-4 mb-0 list-none p-0 font-display text-[13px] leading-loose font-semibold text-muted [font-variant-numeric:lining-nums]">
          <li>2017 · B.E. Electronics &amp; Comms, Tribhuvan University, Kathmandu</li>
          <li>2020 · M. Predictive Analytics, Curtin University, Perth</li>
        </ul>
      </div>
      <div class="min-w-0 flex-[999_1_520px] text-lg leading-[1.85] text-ink-soft">
        <!-- TODO(story): Sujal's own words. Nothing here is to be invented. -->
        <p class="m-0"><Todo text="Draft: replace with your own words" /></p>
        <p class="mt-5 mb-0">
          <Todo text="[Your story in three or four short paragraphs: where you started, what pulled you from electronics engineering into data, the move to Perth, and why you teach.]" />
        </p>
        <p class="mt-5 mb-0">
          <Todo text="[One belief you'd defend in a design review: “everything as code”, including governance, security and the boring parts.]" />
        </p>
      </div>
    </div>
  </section>

  <!-- 07 Contact -->
  <section id="contact" aria-labelledby="contact-title" class="wrap mt-28 pb-24">
    <div class="flex flex-wrap gap-x-[72px] gap-y-12 rounded-[28px] bg-panel p-[clamp(28px,5vw,64px)] text-panel-text">
      <div class="min-w-0 flex-[1_1_360px]">
        <SectionHead num="07" title="Contact" id="contact-title" tone="on-ink" />
        <p class="m-0 font-display text-[clamp(26px,2.6vw,34px)] leading-[1.2] font-extrabold tracking-[-0.01em] text-balance">
          Building a platform you need to trust in five years? <span class="text-teal">Write to me.</span>
        </p>
        <ul class="mt-7 mb-0 list-none p-0 font-display text-[15px] leading-[2.2] font-semibold">
          <li><a href={`mailto:${site.email}`} class="text-white hover:text-teal">{site.email}</a></li>
          <li><a href={site.linkedin} class="text-white hover:text-teal" rel="me noopener">{site.linkedinLabel}</a></li>
          <li class="text-[#a7b0b8]">Perth, WA · {site.timezone}</li>
        </ul>
      </div>
      <ContactForm />
    </div>
  </section>
</Base>
