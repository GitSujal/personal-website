---
import Base from '../layouts/Base.astro';
---

<Base title="Not found" noindex>
  <section class="dots band">
    <div class="wrap">
      <p class="stamp text-[clamp(3rem,10vw,7rem)]" aria-hidden="true">
        404
      </p>
      <h1 class="display-lg mt-10 max-w-3xl">
        This page has <span class="hl cyan now">no lineage.</span>
      </h1>
      <p class="lede mt-6">Nothing upstream produced it. It may have moved when the site was rebuilt.</p>
      <div class="mt-9 flex flex-wrap gap-4">
        <a href="/" class="btn">
          Home{' '}
          <span class="arrow" aria-hidden="true">
            →
          </span>
        </a>
        <a href="/hire-me/" class="btn btn-ghost">
          Hire me
        </a>
      </div>
    </div>
  </section>
</Base>
