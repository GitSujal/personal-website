---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import CtaBand from '../components/ui/CtaBand.astro';
import Icon from '../components/ui/Icon.astro';
import { certifications, site, toolbox } from '../data/site';
import { hire, principles, services } from '../data/copy';
import { rich } from '../lib/rich';

// Whole years since the first full-time role, so this never goes stale.
const [startYear, startMonth] = site.careerStart.split('-').map(Number) as [number, number];
const today = new Date();
const years = Math.floor(
  (today.getFullYear() * 12 + today.getMonth() + 1 - (startYear * 12 + startMonth)) / 12,
);
const tilts = ['-1deg', '0.8deg', '-0.5deg', '1.2deg'];
---

<Base title="Hire me" description={hire.metaDescription}>
  <PageHeader
    eyebrow={hire.eyebrow}
    title={hire.title}
    description={hire.lede.replace('{years}', String(years))}
  >
    <a href={site.resume} class="btn" download>
      Download résumé <Icon name="download" />
    </a>
    <a href="/#contact" class="btn btn-ghost">
      Start a conversation
    </a>
  </PageHeader>

  <section class="band band-paper2 zig-t" aria-labelledby="svc-title">
    <div class="wrap">
      <p class="eyebrow" data-reveal>
        {hire.services.eyebrow}
      </p>
      <h2 id="svc-title" class="display-lg mt-2 max-w-3xl" data-reveal style="--d:1">
        <Fragment set:html={rich(hire.services.title)} />
      </h2>
      <div class="mt-14 grid gap-10 md:grid-cols-2">
        {services.map((s, i) => (
          <article class="paper lift p-7" data-reveal style={`--d:${i % 2}; rotate:${tilts[i]}`}>
            {i === 0 && <span class="tape" aria-hidden="true" />}
            <span class="grid h-12 w-12 place-items-center rounded-full border-2 border-[#111] bg-primary font-display text-xl font-extrabold text-[#111]">
              {i + 1}
            </span>
            <h3 class="mt-5 text-2xl">{s.title}</h3>
            <p class="mt-3 muted">{s.body}</p>
            <ul class="tick-list mt-4">
              {s.evidence.map((e) => (
                <li>{e}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band-ink zig-t band" aria-labelledby="pr-title">
    <div class="wrap">
      <p class="eyebrow !text-[color:var(--cyan)]" data-reveal>
        {hire.rules.eyebrow}
      </p>
      <h2 id="pr-title" class="display-lg mt-2" data-reveal style="--d:1">
        <Fragment set:html={rich(hire.rules.title)} />
      </h2>
      <ol class="mt-14 grid gap-10 lg:grid-cols-3">
        {principles.map((p, i) => (
          <li data-reveal style={`--d:${i + 1}`}>
            <div
              class="grid h-16 w-16 place-items-center rounded-full border-2 border-[#111] bg-primary font-display text-3xl font-extrabold text-[#111] shadow-[4px_4px_0_#000]"
              style={`rotate:${i % 2 ? 6 : -6}deg`}
            >
              {i + 1}
            </div>
            <h3 class="mt-5 text-3xl">{p.title}</h3>
            <p class="mt-3 opacity-85">{p.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="band" aria-labelledby="tb-title">
    <div class="wrap grid gap-14 lg:grid-cols-[1.4fr_1fr]">
      <div>
        <p class="eyebrow" data-reveal>
          {hire.toolbox.eyebrow}
        </p>
        <h2 id="tb-title" class="display-lg mt-2" data-reveal style="--d:1">
          <Fragment set:html={rich(hire.toolbox.title)} />
        </h2>
        <dl class="mt-10 grid gap-4">
          {toolbox.map((row, i) => (
            <div class="paper flat grid gap-1 p-5 sm:grid-cols-[11rem_1fr]" data-reveal style={`--d:${i}`}>
              <dt class="hand text-2xl text-[color:var(--cyan-deep)]">{row.label}</dt>
              <dd class="font-semibold">{row.value}</dd>
            </div>
          ))}
        </dl>
      </div>
      <div>
        <h3 class="hand mt-2 text-3xl text-[color:var(--cyan-deep)] lg:mt-24" data-reveal>
          {hire.toolbox.certified}
        </h3>
        <ul class="mt-5 grid gap-6">
          {certifications.map((c, i) => (
            <li class="paper p-5" style={`rotate:${tilts[i]}`} data-reveal="pop">
              <p class="font-display text-xl font-extrabold">{c.title}</p>
              <p class="mt-1 text-sm font-semibold muted">
                {c.issuer} · {c.year}
              </p>
            </li>
          ))}
        </ul>
        <p class="hand mt-10 text-2xl" data-reveal set:html={rich(hire.availability)} />
      </div>
    </div>
  </section>

  <CtaBand title={hire.cta.title} body={hire.cta.body}>
    <a href="/#contact" class="btn btn-ink">
      Send a message{' '}
      <span class="arrow" aria-hidden="true">
        →
      </span>
    </a>
    <a href={site.linkedin} class="btn btn-paper" rel="me noopener">
      LinkedIn ↗
    </a>
  </CtaBand>
</Base>
