---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import Todo from '../components/Todo.astro';
import { certifications, principles, services, site, toolbox } from '../data/site';
---

<Base
  title="Hire me"
  page="02"
  description="Hire Sujal Dhungana for data platform engineering, infrastructure as code, MLOps and cloud cost engineering. Perth, Western Australia."
>
  <section aria-labelledby="hire-title" class="wrap pt-[clamp(48px,7vw,96px)] pb-14">
    <p class="label m-0 mb-6 text-accent!">For hiring managers &amp; clients</p>
    <h1 id="hire-title" class="m-0 max-w-[14em] font-display text-[clamp(42px,6vw,88px)] leading-none font-black tracking-[-0.03em] text-balance">
      Platforms your team can still <span class="marker">read</span> in five years.
    </h1>
    <div class="mt-11 flex flex-wrap items-start gap-x-[72px] gap-y-8">
      <p class="m-0 min-w-0 flex-[999_1_520px] text-[clamp(17px,1.4vw,19px)] leading-[1.8] text-ink-soft">
        <Todo text="[N]" /> years across mining consulting, utilities, telecoms and startups. I build self-service tooling
        and standardised pipelines, and I build the governance into the code from the start instead of bolting it on at
        the end.
      </p>
      <div class="flex flex-[1_1_300px] flex-col gap-3">
        <a href={site.resume} class="btn btn-teal">Download résumé <span>PDF ↓</span></a>
        <a href="/#contact" class="btn btn-line">Start a conversation <span aria-hidden="true">→</span></a>
        <p class="m-0 font-display text-[13px]"><Todo text="[availability: e.g. “open to contract work from Feb 2027”]" /></p>
      </div>
    </div>
  </section>

  <section aria-labelledby="svc-title" class="wrap pt-14">
    <SectionHead num="01" title="What I'm brought in for" id="svc-title" />
    {
      services.map((service, index) => (
        <article class="reveal flex flex-wrap gap-x-12 gap-y-4 border-t border-rule py-8">
          <p class="m-0 flex flex-[0_0_72px] items-start gap-2 pt-2 font-display text-[13px] font-bold text-muted">
            <span aria-hidden="true" class="mt-1 size-2 bg-teal" />
            {String(index + 1).padStart(2, '0')}
          </p>
          <div class="min-w-0 flex-[999_1_460px]">
            <h3 class="m-0 font-display text-[28px] font-extrabold tracking-[-0.01em]">{service.title}</h3>
            <p class="mt-3 mb-0 max-w-[38em] text-[16.5px] leading-[1.8] text-ink-soft">{service.body}</p>
          </div>
          <aside aria-label={`Evidence for ${service.title}`} class="lineage flex-[1_1_260px] self-start">
            <p class="m-0 font-extrabold text-ink">Evidence</p>
            {service.evidence.map((line) => <p class="m-0">{line}</p>)}
          </aside>
        </article>
      ))
    }
  </section>

  <section aria-labelledby="pr-title" class="wrap reveal mt-28">
    <div class="rounded-[28px] bg-navy p-[clamp(28px,5vw,64px)] text-white">
      <SectionHead num="02" title="How I work" id="pr-title" tone="on-ink" />
      <ol class="m-0 grid list-none grid-cols-[repeat(auto-fit,minmax(260px,1fr))] gap-x-12 gap-y-10 p-0">
        {
          principles.map((principle) => (
            <li class="border-t-2 border-teal pt-5">
              <h3 class="mt-0 mb-2.5 font-display text-2xl font-extrabold">{principle.title}</h3>
              <p class="m-0 text-base leading-[1.8] text-[#e3eef5]">{principle.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section aria-labelledby="tb-title" class="wrap reveal pt-28">
    <SectionHead num="03" title="Toolbox" id="tb-title" />
    <div class="flex flex-wrap gap-x-[72px] gap-y-10">
      <dl class="m-0 min-w-0 flex-[999_1_560px]">
        {
          toolbox.map((row) => (
            <div class="flex flex-wrap gap-x-6 gap-y-1 border-t border-rule py-4">
              <dt class="label flex-[0_0_200px] pt-1">{row.label}</dt>
              <dd class="m-0 flex-[1_1_300px] text-[16.5px] leading-relaxed font-normal">{row.value}</dd>
            </div>
          ))
        }
      </dl>
      <div class="flex-[1_1_300px]">
        <h3 class="label m-0 mb-2">Certified</h3>
        <ul class="m-0 list-none border-b border-rule p-0">
          {
            certifications.map((cert) => (
              <li class="border-t border-rule py-4">
                <p class="m-0 font-display text-[19px] font-extrabold">{cert.title}</p>
                <p class="mt-1 mb-0 font-display text-[13px] font-semibold text-muted">
                  {cert.issuer} · {cert.year}
                </p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section aria-labelledby="enq-title" class="wrap reveal mt-28 pb-24">
    <div class="flex flex-wrap items-end gap-x-16 gap-y-8 rounded-[28px] bg-teal p-[clamp(28px,5vw,64px)] text-black">
      <div class="min-w-0 flex-[999_1_480px]">
        <p class="m-0 mb-3.5 font-display text-xs font-extrabold tracking-[0.18em] uppercase">04 — Enquire</p>
        <h2 id="enq-title" class="m-0 font-display text-[clamp(32px,3.8vw,52px)] leading-[1.05] font-black tracking-[-0.02em] text-balance">
          Tell me what's breaking, or what you want to build.
        </h2>
      </div>
      <div class="flex flex-[1_1_280px] flex-col gap-3">
        <a href="/#contact" class="btn bg-black text-white hover:text-white">Send a message <span aria-hidden="true">→</span></a>
        <a href={site.linkedin} class="btn border-2 border-black text-black hover:text-black" rel="me noopener">LinkedIn <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</Base>
