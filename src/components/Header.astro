---
import Icon from './ui/Icon.astro';
import Logo from './ui/Logo.astro';
import { navigation } from '../data/site';

const path = Astro.url.pathname;
const cur = (href: string) => {
  const p = href.split('#')[0] ?? href;
  return p !== '/' && path.startsWith(p) ? 'page' : undefined;
};
const iconBtn =
  'grid h-10 w-10 place-items-center rounded-full border-2 border-[color:var(--line)] bg-[color:var(--card)] hover:bg-primary hover:text-[#111]';
---

<header class="sticky top-0 z-50 border-b-2 border-[color:var(--line)] bg-[color:var(--paper)]/92 backdrop-blur-sm">
  <nav class="wrap" aria-label="Primary">
    <div class="flex items-center justify-between gap-4 py-3">
      <Logo />
      <div class="hidden items-center gap-3 lg:flex">
        <ul class="flex items-center gap-1">
          {navigation.map((item) => (
            <li>
              <a href={item.href} aria-current={cur(item.href)} class="nav-link">
                {item.name}
              </a>
            </li>
          ))}
        </ul>
        <button
          type="button"
          data-theme-toggle
          aria-label="Toggle light or dark theme"
          class:list={[iconBtn, 'wiggle']}
        >
          <Icon name="sun" class="hidden h-5 w-5 dark:block" />
          <Icon name="moon" class="h-5 w-5 dark:hidden" />
        </button>
        <a href="/hire-me/" class="btn !py-2.5 !text-base" aria-current={cur('/hire-me/')}>
          Hire me
        </a>
      </div>
      <div class="flex items-center gap-2 lg:hidden">
        <button type="button" data-theme-toggle aria-label="Toggle light or dark theme" class={iconBtn}>
          <Icon name="sun" class="hidden h-5 w-5 dark:block" />
          <Icon name="moon" class="h-5 w-5 dark:hidden" />
        </button>
        <button
          type="button"
          id="menu-button"
          aria-expanded="false"
          aria-controls="mobile-menu"
          class="grid h-10 w-10 place-items-center rounded-full border-2 border-[color:var(--line)] bg-primary text-[#111]"
        >
          <span class="sr-only">Toggle main menu</span>
          <span data-open>
            <Icon name="menu" />
          </span>
          <span data-close class="hidden">
            <Icon name="x" />
          </span>
        </button>
      </div>
    </div>
    <div id="mobile-menu" class="hidden pb-5 lg:hidden">
      <ul class="grid gap-1 font-display">
        {navigation.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={cur(item.href)}
              class="block rounded-xl px-3 py-2 text-2xl font-extrabold hover:bg-primary hover:text-[#111] aria-[current=page]:bg-primary aria-[current=page]:text-[#111]"
            >
              {item.name}
            </a>
          </li>
        ))}
      </ul>
      <a href="/hire-me/" class="btn mt-4 w-full">
        Hire me
      </a>
    </div>
  </nav>
</header>

<script>
  for (const btn of document.querySelectorAll('[data-theme-toggle]')) {
    btn.addEventListener('click', () => {
      const dark = document.documentElement.classList.toggle('dark');
      try {
        localStorage.setItem('theme', dark ? 'dark' : 'light');
      } catch {
        /* storage blocked: theme applies to this page only */
      }
    });
  }

  const button = document.getElementById('menu-button');
  const menu = document.getElementById('mobile-menu');
  const setOpen = (open: boolean) => {
    menu?.classList.toggle('hidden', !open);
    button?.setAttribute('aria-expanded', String(open));
    button?.querySelector('[data-open]')?.classList.toggle('hidden', open);
    button?.querySelector('[data-close]')?.classList.toggle('hidden', !open);
  };
  button?.addEventListener('click', () => setOpen(menu?.classList.contains('hidden') ?? false));
  // In-page links (/#work) don't navigate, so close the menu ourselves.
  menu?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });
</script>
