---
/**
 * Contact form. A plain POST to the Astro API route at /api/contact (runs on the Worker); the script below upgrades it to an
 * in-place submission with field errors.
 *
 * Turnstile site key is public by design. `npm run dev` uses Cloudflare's always-pass TEST key
 * (the real widget only runs on sujal.datasparta.com); production builds use the real one.
 * Override either with PUBLIC_TURNSTILE_SITE_KEY.
 */
import { TOPICS } from '../lib/contact';

const SITE_KEY = '0x4AAAAAAFUPBxdYrOw85S6c';
const TEST_SITE_KEY = '1x00000000000000000000AA';
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || (import.meta.env.DEV ? TEST_SITE_KEY : SITE_KEY);

const topics = Object.entries(TOPICS).map(([value, label]) => ({ value, label }));
const label = 'block font-display text-base font-extrabold';
---

<form method="post" action="/api/contact" class="grid gap-5" data-contact-form novalidate>
  <div class="grid gap-5 sm:grid-cols-2">
    <label class={label}>
      Name
      <input
        class="field"
        type="text"
        name="name"
        autocomplete="name"
        required
        maxlength="100"
        aria-describedby="err-name"
      />
      <span id="err-name" class="field-error" data-error="name"></span>
    </label>
    <label class={label}>
      Email
      <input
        class="field"
        type="email"
        name="email"
        autocomplete="email"
        required
        maxlength="254"
        aria-describedby="err-email"
      />
      <span id="err-email" class="field-error" data-error="email"></span>
    </label>
  </div>

  <fieldset class="m-0 border-0 p-0">
    <legend class:list={[label, 'mb-3']}>This is about</legend>
    <div class="flex flex-wrap gap-2">
      {topics.map(({ value, label: text }, index) => (
        <label class="inline-flex min-h-11 cursor-pointer items-center gap-2 rounded-full border-2 border-[color:var(--line)] bg-[color:var(--card)] px-4 font-display text-sm font-bold has-checked:bg-primary has-checked:text-[#111] has-checked:shadow-[3px_3px_0_var(--shadow)] has-focus-visible:outline-3 has-focus-visible:outline-[color:var(--cyan-deep)]">
          <input type="radio" name="topic" value={value} checked={index === 0} class="accent-[#111]" />
          {text}
        </label>
      ))}
    </div>
  </fieldset>

  <label class={label}>
    Message
    <textarea
      class="field min-h-40 leading-relaxed"
      name="message"
      rows="5"
      required
      minlength="10"
      maxlength="5000"
      aria-describedby="err-message"
      placeholder="What are you building, or what's breaking?"
    ></textarea>
    <span id="err-message" class="field-error" data-error="message"></span>
  </label>

  <!-- Honeypot: hidden from people and assistive tech; bots fill it in. -->
  <div class="absolute -left-[9999px]" aria-hidden="true">
    <label>
      Company <input type="text" name="company" tabindex="-1" autocomplete="off" />
    </label>
  </div>

  <div class="cf-turnstile" data-sitekey={siteKey} data-action="contact" data-size="flexible"></div>

  <div class="flex flex-wrap items-center justify-between gap-4">
    <p class="hand text-xl muted">straight to my inbox, no CRM</p>
    <button type="submit" class="btn disabled:cursor-wait disabled:opacity-70" data-submit>
      Send message{' '}
      <span class="arrow" aria-hidden="true">
        →
      </span>
    </button>
  </div>
  <p role="status" aria-live="polite" class="min-h-6 font-display font-bold" data-status></p>
</form>

<script>
  type Result = { ok: true } | { ok: false; code: string; message: string; fields?: Record<string, string> };

  const MESSAGES: Record<string, string> = {
    invalid: 'Please check the highlighted fields.',
    turnstile_failed: "We couldn't confirm you're human. Please retry the check and send again.",
    send_failed: "The message couldn't be delivered. Please email me directly instead.",
    too_large: 'That message is too long.',
  };

  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  if (form) {
    // Turnstile is third-party JS: only fetch it when the form is about to be seen.
    const loadTurnstile = () => {
      if (document.querySelector('script[data-turnstile]')) return;
      const script = document.createElement('script');
      script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js';
      script.async = true;
      script.dataset.turnstile = '';
      document.head.append(script);
    };
    new IntersectionObserver(
      (entries, observer) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          loadTurnstile();
          observer.disconnect();
        }
      },
      { rootMargin: '800px 0px' },
    ).observe(form);
    form.addEventListener('focusin', loadTurnstile, { once: true });

    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;

    // No-JS fallback lands on /?contact=<code>#contact after a failed post.
    const code = new URLSearchParams(location.search).get('contact');
    if (code) status.textContent = MESSAGES[code] ?? 'Something went wrong. Please try again.';

    const clearErrors = () => {
      form.querySelectorAll<HTMLElement>('[data-error]').forEach((el) => (el.textContent = ''));
      form.querySelectorAll('[aria-invalid]').forEach((el) => el.removeAttribute('aria-invalid'));
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      clearErrors();
      submit.disabled = true;
      status.textContent = 'Sending…';

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        const result = (await res.json()) as Result;

        if (result.ok) {
          form.reset();
          status.textContent = "Thanks. Your message is on its way, and I'll reply from my own inbox.";
          return;
        }
        for (const [name, message] of Object.entries(result.fields ?? {})) {
          form.querySelector(`[name="${name}"]`)?.setAttribute('aria-invalid', 'true');
          const slot = form.querySelector<HTMLElement>(`[data-error="${name}"]`);
          if (slot) slot.textContent = message;
        }
        status.textContent = result.message;
        form.querySelector<HTMLElement>('[aria-invalid="true"]')?.focus();
      } catch {
        status.textContent = 'Network error. Please try again, or email me directly.';
      } finally {
        submit.disabled = false;
        window.turnstile?.reset();
      }
    });
  }
</script>
