---
interface Props {
  num: string;
  title: string;
  id: string;
  /** "light" for use on teal or ink panels. */
  tone?: 'default' | 'on-teal' | 'on-ink';
}
const { num, title, id, tone = 'default' } = Astro.props;
const numColour = { default: 'text-accent', 'on-teal': 'text-black', 'on-ink': 'text-teal' }[tone];
const titleColour = { default: 'text-ink', 'on-teal': 'text-black', 'on-ink': 'text-panel-text' }[tone];
---

<div class="mb-9 flex flex-wrap items-end gap-x-6 gap-y-2">
  <span
    aria-hidden="true"
    class:list={['font-display text-[clamp(64px,7vw,88px)] leading-[0.8] font-black [font-variant-numeric:oldstyle-nums]', numColour]}
    >{num}</span
  >
  <h2
    id={id}
    class:list={[
      'm-0 font-display text-[clamp(28px,3.2vw,42px)] font-extrabold tracking-[0.02em] uppercase',
      titleColour,
    ]}
  >
    {title}
  </h2>
  <slot />
</div>
