---
/** The incurred-cost graph: one line per source, plus the total, against time. ./controller.ts draws it. */
import { SOURCES } from './sources';
---

<svg data-cost-chart viewBox="0 0 400 190" role="img" aria-label="Cumulative cost of each source over time">
  <line class="axis" x1="34" y1="10" x2="34" y2="160"></line>
  <line class="axis" x1="34" y1="160" x2="330" y2="160"></line>
  <text class="tick" x="28" y="14" text-anchor="end" data-cost-ymax>
    $5
  </text>
  <text class="tick" x="28" y="163" text-anchor="end">
    $0
  </text>
  <text class="tick" x="34" y="178">
    0 s
  </text>
  <text class="tick" x="330" y="178" text-anchor="end" data-cost-xmax>
    60 s
  </text>
  {SOURCES.map((s, i) => (
    <path class="line" data-series={i} d="M34,160" style={`stroke: ${s.color}`} />
  ))}
  <path class="line line-total" data-series="total" d="M34,160"></path>
  {SOURCES.map((s, i) => (
    <text class="end" data-cost-label={i} x="336" y="160" style={`fill: ${s.color}`}>
      {s.letter} <tspan data-cost-count>$0</tspan>
    </text>
  ))}
</svg>

<style>
  svg {
    display: block;
    width: 100%;
    height: auto;
    margin-top: 6px;
    overflow: visible;
  }
  .axis {
    stroke: rgba(255, 255, 255, 0.25);
    stroke-width: 1.5;
  }
  .tick {
    fill: #9fb3c2;
    font-size: 10px;
    font-weight: 600;
  }
  .line {
    fill: none;
    stroke-width: 2.5;
    stroke-linejoin: round;
  }
  .line-total {
    stroke: #ffffff;
    stroke-width: 1.5;
    stroke-dasharray: 5 4;
  }
  .end {
    font-size: 11px;
    font-weight: 800;
  }
</style>
