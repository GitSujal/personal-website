---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/figtree';
import '@fontsource/caveat/700.css';
import '../styles/global.css';
import { getCollection } from 'astro:content';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  /** Page title; the site name is appended. Omit on the home page. */
  title?: string;
  description?: string;
  noindex?: boolean;
  /** Full-screen page with no header or footer (the 3D lab). */
  bare?: boolean;
}

const { title, description = site.description, noindex = false, bare = false } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name} | Data engineer, Perth`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);

const current = (await getCollection('roles', ({ data }) => data.current && data.kind === 'work')).map(
  ({ data }) => data,
);
const ventures = (await getCollection('roles', ({ data }) => data.current && data.kind === 'venture')).map(
  ({ data }) => data,
);
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: site.url,
  image: new URL('/sujal-dhungana.jpg', Astro.site).href,
  email: `mailto:${site.email}`,
  jobTitle: current[0]?.title ?? 'Data Engineer',
  worksFor: [...current, ...ventures].map((role) => ({ '@type': 'Organization', name: role.org })),
  address: { '@type': 'PostalAddress', addressLocality: 'Perth', addressRegion: 'WA', addressCountry: 'AU' },
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'Curtin University' },
    { '@type': 'CollegeOrUniversity', name: 'Tribhuvan University' },
  ],
  knowsAbout: [
    'Data engineering',
    'Data platforms',
    'Infrastructure as code',
    'MLOps',
    'Cloud cost optimisation',
  ],
  sameAs: [site.linkedin, site.dataSparta, site.academy],
};
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="author" content={site.name} />
    <meta name="theme-color" content="#3ec1d3" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM-readable summary" />

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_AU" />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>
      // Set theme before paint to avoid a flash; flag JS so reveal styles only apply when they can resolve.
      try {
        const t = localStorage.getItem('theme');
        const dark = t === 'dark' || (!t && matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.classList.toggle('dark', dark);
      } catch {
        /* storage blocked: light theme */
      }
      document.documentElement.classList.add('js');
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main" class="btn sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100]">
      Skip to content
    </a>
    {bare ? (
      <main id="main">
        <slot />
      </main>
    ) : (
      <>
        <Header />
        <main id="main" class="flex-grow">
          <slot />
        </main>
        <Footer />
      </>
    )}
    <script>
      const els = document.querySelectorAll<HTMLElement>('[data-reveal], .hl');
      if (!('IntersectionObserver' in window)) {
        for (const el of els) el.classList.add('is-in');
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
        );
        for (const el of els) io.observe(el);
      }
    </script>
  </body>
</html>
