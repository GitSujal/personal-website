{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sujal-portfolio",
  // No "main" or "assets": @astrojs/cloudflare generates the Worker entry and the static-assets
  // config at build time, the same way datasparta.com is deployed.
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],

  // Contact form → email. The sender domain must be onboarded to Cloudflare Email Service,
  // and CONTACT_TO (sujal@datasparta.com) must be a verified destination address on the account.
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_destination_addresses": ["sujal@datasparta.com"],
      "allowed_sender_addresses": ["website@datasparta.com"],
    },
  ],

  "vars": {
    "CONTACT_TO": "sujal@datasparta.com",
    "CONTACT_FROM": "website@datasparta.com",
    "SITE_HOST": "sujal.datasparta.com",
    // Hostnames a Turnstile token may come from (comma-separated). Never add localhost here;
    // local dev overrides this in .dev.vars.
    "TURNSTILE_HOSTNAMES": "sujal.datasparta.com",
  },
  // Secret (not in this file): TURNSTILE_SECRET. Set with `npx wrangler secret put TURNSTILE_SECRET`.

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },

  // Uncomment at cutover, once the workers.dev deployment is verified:
  // "routes": [
  //   { "pattern": "sujal.datasparta.com", "custom_domain": true },
  // ],
}
